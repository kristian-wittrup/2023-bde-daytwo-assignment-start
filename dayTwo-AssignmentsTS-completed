 * 
 * */
 
// Completed Assignment
type CalculateSumFunction = (a: number, b: number) => number;
const calculateSum: CalculateSumFunction = (a, b) => {
    return a + b;
};

const num1 = 5;
const num2 = 10;
const sum = calculateSum(num1, num2);
console.log(`The sum of ${num1} and ${num2} is ${sum}`);



