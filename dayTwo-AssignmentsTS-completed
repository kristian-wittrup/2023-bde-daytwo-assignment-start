/**
 * Assignment 6: Interface
 * Assignment Description:
 * Interfaces are essential in TypeScript. 
 * Define an interface YourInterface with 
 * properties yourProperty1:string and yourProperty2:number. 
 * Create a class YourClass that implements this 
 * interface and uses these properties. 
 * 
 * Instantiate a YourClass object and display its properties.
 */


// Completed Assignment
// Step 1: Define an interface YourInterface
interface YourInterface {
  yourProperty1: string;
  yourProperty2: number;
}

// Step 2: Create a class YourClass that implements YourInterface
class YourClass implements YourInterface {
  yourProperty1: string;
  yourProperty2: number;

  // Step 3: Implement the properties in YourClass
  constructor(yourProperty1: string, yourProperty2: number) {
      this.yourProperty1 = yourProperty1;
      this.yourProperty2 = yourProperty2;
  }
}

// Step 4: Instantiate an object of YourClass
const yourClassInstance = new YourClass("Example String", 42);

// Step 5: Display the properties of the instantiated object
console.log(`yourProperty1: ${yourClassInstance.yourProperty1}`);
console.log(`yourProperty2: ${yourClassInstance.yourProperty2}`);
