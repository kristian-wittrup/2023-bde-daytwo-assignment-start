class Employee {
  public employeeName: string;
  private employeeId: number;
  readonly employeeTitle: string;

  constructor(name: string, id: number, employeeTitle: string) {
    this.employeeName = name;
    this.employeeId = id;
    this.employeeTitle = employeeTitle;
  }
